<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Inventory aging report wizard                                 -->
    <!-- ============================================================ -->
    <record id="view_akshab_stock_aging_wizard_form" model="ir.ui.view">
        <field name="name">akshab.stock.aging.wizard.form</field>
        <field name="model">akshab.stock.aging.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير أعمار المخزون">
                <div class="alert alert-info mb-3" role="status" style="border-inline-start: 4px solid #1F3D2F; background:#F6F3EC; color:#1F3D2F;">
                    <strong>تقرير أعمار المخزون</strong> — جدول الفئات ثم جدول الأصناف (الصنف، الفئة، المرجع الداخلي، الوحدة) مع الكمية والقيمة لكل فئة عمرية.
                    يمكن اختيار أكثر من فئة/صنف/موقع/فرع، وتحديد طول الفئة العمرية (مثلاً كل 30 يوماً).
                </div>
                <group>
                    <group string="النطاق">
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="company_id" invisible="1"/>
                        <field name="date_to"/>
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع المستودعات"/>
                        <field name="location_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع المواقع الداخلية"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع الفئات"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع الأصناف"/>
                    </group>
                    <group string="الفئات العمرية">
                        <field name="bucket_mode" widget="radio"/>
                        <field name="bucket_days" invisible="bucket_mode != 'step'" required="bucket_mode == 'step'"/>
                        <field name="bucket_count" invisible="bucket_mode != 'step'" required="bucket_mode == 'step'"/>
                        <field name="bucket_1" invisible="bucket_mode != 'custom'" required="bucket_mode == 'custom'"/>
                        <field name="bucket_2" invisible="bucket_mode != 'custom'" required="bucket_mode == 'custom'"/>
                        <field name="bucket_3" invisible="bucket_mode != 'custom'" required="bucket_mode == 'custom'"/>
                        <field name="bucket_4" invisible="bucket_mode != 'custom'" required="bucket_mode == 'custom'"/>
                        <field name="bucket_5" invisible="bucket_mode != 'custom'" required="bucket_mode == 'custom'"/>
                    </group>
                </group>
                <group>
                    <group string="خيارات العرض">
                        <field name="show_value"/>
                        <field name="show_warehouse_split"/>
                        <field name="max_lines"/>
                    </group>
                    <group string="التقييم">
                        <field name="cost_basis"/>
                        <field name="aging_scope" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="طباعة PDF" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" string="تصدير Excel" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_akshab_stock_aging_wizard" model="ir.actions.act_window">
        <field name="name">تقرير أعمار المخزون</field>
        <field name="res_model">akshab.stock.aging.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_akshab_stock_aging_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!-- Inventory turnover report wizard                              -->
    <!-- ============================================================ -->
    <record id="view_akshab_stock_turnover_wizard_form" model="ir.ui.view">
        <field name="name">akshab.stock.turnover.wizard.form</field>
        <field name="model">akshab.stock.turnover.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير معدل دوران المخزون">
                <div class="alert alert-info mb-3" role="status" style="border-inline-start: 4px solid #1F3D2F; background:#F6F3EC; color:#1F3D2F;">
                    <strong>تقرير معدل دوران المخزون</strong> — جدول الفئات ثم جدول الأصناف مع أطراف المعادلة: مخزون البداية والنهاية، متوسط المخزون،
                    تكلفة المبيعات (COGS)، معدل الدوران للفترة والسنوي، أيام المخزون (Inventory Days) والتغطية على مستوى الصنف،
                    ثم قوائم الأصناف الأكثر دوراناً والأقل دوراناً وبلا دوران.
                </div>
                <group>
                    <group string="النطاق">
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="company_id" invisible="1"/>
                        <field name="date_from"/>
                        <field name="date_to" string="الفترة إلى (تاريخ المخزون)"/>
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع المستودعات"/>
                        <field name="location_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع المواقع الداخلية"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع الفئات"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع الأصناف"/>
                    </group>
                    <group string="معايير الاحتساب">
                        <field name="coverage_days"/>
                        <field name="cogs_basis"/>
                        <field name="cost_basis"/>
                        <field name="aging_scope" widget="radio"/>
                        <field name="top_n"/>
                        <field name="max_lines"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="طباعة PDF" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" string="تصدير Excel" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_akshab_stock_turnover_wizard" model="ir.actions.act_window">
        <field name="name">تقرير معدل دوران المخزون</field>
        <field name="res_model">akshab.stock.turnover.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_akshab_stock_turnover_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!-- Item status report wizard                                     -->
    <!-- ============================================================ -->
    <record id="view_akshab_stock_status_wizard_form" model="ir.ui.view">
        <field name="name">akshab.stock.status.wizard.form</field>
        <field name="model">akshab.stock.status.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير حالة الأصناف">
                <div class="alert alert-info mb-3" role="status" style="border-inline-start: 4px solid #1F3D2F; background:#F6F3EC; color:#1F3D2F;">
                    <strong>تقرير حالة الأصناف</strong> — الأصناف الراكدة وبطيئة الحركة والنشطة (والنافدة التي لها طلب) مع جميع بيانات الصنف،
                    واقتراحات إعادة التوزيع بين المستودعات، وتحديد معايير التصنيف من هذه النافذة. يمكن اختيار أكثر من فئة/صنف/موقع/مستودع.
                </div>
                <group>
                    <group string="النطاق">
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="company_id" invisible="1"/>
                        <field name="date_from"/>
                        <field name="date_to" string="تاريخ المخزون (نهاية الفترة)"/>
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع المستودعات"/>
                        <field name="location_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع المواقع الداخلية"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع الفئات"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="جميع الأصناف"/>
                    </group>
                    <group string="معايير التصنيف">
                        <field name="stagnant_days"/>
                        <field name="slow_cover_days"/>
                        <field name="reorder_cover_days"/>
                        <field name="cost_basis"/>
                        <field name="aging_scope" widget="radio"/>
                    </group>
                </group>
                <group>
                    <group string="الأقسام المعروضة">
                        <field name="show_stagnant"/>
                        <field name="show_slow"/>
                        <field name="show_active"/>
                        <field name="show_out_of_stock"/>
                        <field name="show_transfers"/>
                    </group>
                    <group string="خيارات العرض">
                        <field name="max_lines"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="طباعة PDF" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" string="تصدير Excel" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_akshab_stock_status_wizard" model="ir.actions.act_window">
        <field name="name">تقرير حالة الأصناف</field>
        <field name="res_model">akshab.stock.status.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_akshab_stock_status_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!-- Menus: Inventory > Reporting > تقارير المخزون (أخشاب) > ...  -->
    <!--        Accounting > Reporting > تقارير المخزون (أخشاب) > ...  -->
    <!-- ============================================================ -->
    <menuitem id="menu_akshab_stock_reports_root"
              name="تقارير المخزون (أخشاب)"
              parent="stock.menu_warehouse_report"
              sequence="5"
              groups="stock.group_stock_user"/>
    <menuitem id="menu_akshab_stock_report_full"
              name="التقرير الشامل (أعمار وركود وتوصيات)"
              parent="menu_akshab_stock_reports_root"
              action="action_akshab_stock_report_wizard"
              sequence="1"/>
    <menuitem id="menu_akshab_stock_aging"
              name="أعمار المخزون"
              parent="menu_akshab_stock_reports_root"
              action="action_akshab_stock_aging_wizard"
              sequence="2"/>
    <menuitem id="menu_akshab_stock_turnover"
              name="معدل دوران المخزون"
              parent="menu_akshab_stock_reports_root"
              action="action_akshab_stock_turnover_wizard"
              sequence="3"/>
    <menuitem id="menu_akshab_stock_status"
              name="حالة الأصناف (راكد / بطيء / نشط)"
              parent="menu_akshab_stock_reports_root"
              action="action_akshab_stock_status_wizard"
              sequence="4"/>

    <menuitem id="menu_akshab_stock_reports_root_account"
              name="تقارير المخزون (أخشاب)"
              parent="account.menu_finance_reports"
              sequence="90"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_akshab_stock_report_full_account"
              name="التقرير الشامل (أعمار وركود وتوصيات)"
              parent="menu_akshab_stock_reports_root_account"
              action="action_akshab_stock_report_wizard"
              sequence="1"/>
    <menuitem id="menu_akshab_stock_aging_account"
              name="أعمار المخزون"
              parent="menu_akshab_stock_reports_root_account"
              action="action_akshab_stock_aging_wizard"
              sequence="2"/>
    <menuitem id="menu_akshab_stock_turnover_account"
              name="معدل دوران المخزون"
              parent="menu_akshab_stock_reports_root_account"
              action="action_akshab_stock_turnover_wizard"
              sequence="3"/>
    <menuitem id="menu_akshab_stock_status_account"
              name="حالة الأصناف (راكد / بطيء / نشط)"
              parent="menu_akshab_stock_reports_root_account"
              action="action_akshab_stock_status_wizard"
              sequence="4"/>
</odoo>
