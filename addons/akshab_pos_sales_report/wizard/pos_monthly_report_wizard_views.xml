<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_akshab_pos_monthly_report_wizard_form" model="ir.ui.view">
        <field name="name">akshab.pos.monthly.report.wizard.form</field>
        <field name="model">akshab.pos.monthly.report.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير المبيعات الشهري">
                <group>
                    <group string="الشهر">
                        <field name="month_start"/>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                    </group>
                    <group string="قنوات البيع">
                        <field name="config_ids" widget="many2many_tags"
                               options="{'no_create': True}" nolabel="1" colspan="2"/>
                        <field name="online_move_ids" widget="many2many_tags"
                               groups="account.group_account_invoice"
                               options="{'no_create': True}"
                               placeholder="اختر فواتير قناة Online Store (اختياري)"/>
                        <field name="online_move_prev_ids" widget="many2many_tags"
                               groups="account.group_account_invoice"
                               options="{'no_create': True}"
                               placeholder="فواتير Online Store للشهر السابق - للمقارنة (اختياري)"/>
                        <field name="online_move_m2_ids" widget="many2many_tags"
                               groups="account.group_account_invoice"
                               options="{'no_create': True}"
                               placeholder="فواتير Online Store قبل شهرين - لقسم الاتجاه (اختياري)"/>
                        <field name="online_move_m3_ids" widget="many2many_tags"
                               groups="account.group_account_invoice"
                               options="{'no_create': True}"
                               placeholder="فواتير Online Store قبل ثلاثة أشهر - لقسم الاتجاه (اختياري)"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="طباعة التقرير"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="إلغاء" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_akshab_pos_monthly_report_wizard" model="ir.actions.act_window">
        <field name="name">تقرير المبيعات الشهري</field>
        <field name="res_model">akshab.pos.monthly.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_akshab_pos_monthly_report"
              name="تقرير المبيعات الشهري"
              parent="point_of_sale.menu_point_rep"
              action="action_akshab_pos_monthly_report_wizard"
              groups="point_of_sale.group_pos_manager"
              sequence="7"/>
</odoo>
