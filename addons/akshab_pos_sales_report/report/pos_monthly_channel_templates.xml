<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_monthly_channel_doc">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="company" t-value="docs.env.company"/>
                <div class="page" dir="rtl">
                    <div class="akshab-report">
                        <style>
                        @font-face {
                            font-family: 'Tajawal';
                            src: url('/akshab_pos_sales_report/static/fonts/Tajawal-Regular.ttf') format('truetype');
                            font-weight: normal;
                            font-style: normal;
                        }
                        @font-face {
                            font-family: 'Tajawal';
                            src: url('/akshab_pos_sales_report/static/fonts/Tajawal-Medium.ttf') format('truetype');
                            font-weight: 500;
                            font-style: normal;
                        }
                        @font-face {
                            font-family: 'Tajawal';
                            src: url('/akshab_pos_sales_report/static/fonts/Tajawal-Bold.ttf') format('truetype');
                            font-weight: bold;
                            font-style: normal;
                        }
                        .akshab-report {
                            direction: rtl;
                            text-align: right;
                            font-family: 'Tajawal', 'Noto Naskh Arabic', 'DejaVu Sans', sans-serif;
                            color: #26312B;
                            font-size: 15px;
                        }
                        .akshab-report table { direction: rtl; }
                        /* ---------- الترويسة (divs عائمة - بدون جدول = استحالة ظهور خطوط) ---------- */
                        .ak-header { width: 100%; overflow: hidden; margin-bottom: 16px; }
                        .ak-header-titles { float: right; text-align: right; }
                        .ak-header-logo { float: left; text-align: left; }
                        .ak-logo { max-height: 76px; max-width: 230px; }
                        .ak-title { font-size: 32px; font-weight: bold; color: #1B4332; margin: 0; line-height: 1.25; border: 0 !important; }
                        .ak-subtitle { font-size: 15px; color: #C6A46C; font-weight: bold; margin: 3px 0 0 0; letter-spacing: 3px; border: 0 !important; }
                        /* ---------- مؤشرات الأداء ---------- */
                        .akshab-report .ak-kpi-table { width: 100%; border-collapse: separate; border-spacing: 5px 0; margin: 4px 0 14px 0; border: 0 !important; }
                        .akshab-report .ak-kpi-table td {
                            background-color: #F7F4EE;
                            border: 0 !important;
                            border-top: 3px solid #C6A46C !important;
                            border-bottom: 1px solid #E5DECF !important;
                            padding: 11px 6px 9px 6px;
                            text-align: center;
                            width: 14.28%;
                        }
                        .ak-kpi-value { font-size: 19px; font-weight: bold; color: #1B4332; direction: ltr; unicode-bidi: embed; white-space: nowrap; }
                        .ak-kpi-value-rtl { font-size: 19px; font-weight: bold; color: #1B4332; direction: rtl; white-space: nowrap; }
                        .ak-kpi-label { font-size: 12.5px; color: #7A6A45; font-weight: 500; margin-top: 3px; }
                        /* ---------- صندوق معلومات الفترة ---------- */
                        .akshab-report .ak-info-box { width: 100%; border-collapse: collapse; margin-bottom: 20px; background-color: #FDFCF9; }
                        .akshab-report .ak-info-box td { padding: 9px 15px; font-size: 14.5px; border: 1px solid #E5DECF !important; }
                        .akshab-report .ak-info-box td.ak-info-label { color: #1B4332; font-weight: bold; white-space: nowrap; width: 1%; background-color: #EFE9DC; }
                        /* ---------- منع انفصال العنوان عن محتواه بين الصفحات ---------- */
                        .ak-keep { page-break-inside: avoid; }
                        .ak-page-start { page-break-before: always; }
                        .ak-charts { width: 100%; border-collapse: collapse; margin-top: 26px; }
                        .ak-charts td.ak-chart-cell { width: 50%; vertical-align: top; padding: 0 7px; }
                        .ak-chart-box { background-color: #FDFCF9; border: 1px solid #E5DECF; padding: 12px 16px 14px 16px; }
                        .ak-chart-title { font-size: 14.5px; font-weight: bold; color: #1B4332; margin-bottom: 11px; padding-bottom: 6px; border-bottom: 2px solid #C6A46C; }
                        .ak-hbar-row { margin: 7px 0; }
                        .ak-hbar-label { display: inline-block; width: 30%; font-size: 12.5px; color: #26312B; vertical-align: middle; }
                        .ak-hbar-track { display: inline-block; width: 42%; background-color: #EFE9DC; height: 13px; vertical-align: middle; }
                        .ak-hbar-fill { height: 13px; background-color: #1B4332; }
                        .ak-hbar-val { display: inline-block; width: 25%; font-size: 11.5px; color: #52604F; text-align: left; vertical-align: middle; direction: ltr; }
                        .ak-cols { width: 100%; border-collapse: collapse; margin-top: 4px; }
                        .ak-cols td { text-align: center; vertical-align: bottom; padding: 0 5px; }
                        .ak-colbar { margin: 0 auto; width: 32px; background-color: #1B4332; }
                        .ak-colbar-gold { margin: 0 auto; width: 32px; background-color: #C6A46C; }
                        .ak-col-val { font-size: 10.5px; color: #52604F; padding-bottom: 3px; direction: ltr; }
                        .ak-cols .ak-col-label { font-size: 11.5px; font-weight: bold; color: #26312B; padding-top: 5px; border-top: 2px solid #1B4332; vertical-align: top; }
                        .ak-section-block { margin-top: 26px; }
                        /* ---------- عناوين الأقسام ---------- */
                        .ak-section-title {
                            background-color: #1B4332; color: #FFFFFF;
                            font-size: 18.5px; font-weight: bold;
                            padding: 10px 17px; margin: 26px 0 0 0;
                            border-right: 6px solid #C6A46C;
                            page-break-after: avoid;
                        }
                        .akshab-report .ak-table caption.ak-section-caption {
                            caption-side: top;
                            background-color: #1B4332; color: #FFFFFF;
                            font-size: 18.5px; font-weight: bold;
                            padding: 10px 17px; text-align: right;
                            border-right: 6px solid #C6A46C;
                            margin: 0;
                        }
                        .ak-table thead tr { page-break-inside: avoid; }
                        .akshab-report .ak-section-table { margin-top: 26px; }
                        .ak-section-num {
                            display: inline-block; color: #C6A46C; font-weight: bold; margin-left: 10px;
                        }
                        /* ---------- الجداول ---------- */
                        .akshab-report .ak-table { width: 100%; border-collapse: collapse; margin-top: 0; }
                        .akshab-report .ak-table th {
                            background-color: #1B4332; color: #FFFFFF;
                            padding: 10px 8px; font-size: 15px; font-weight: bold;
                            border: 1px solid #143226 !important; text-align: center;
                        }
                        .akshab-report .ak-table td {
                            padding: 8px 8px; font-size: 14.5px;
                            border: 1px solid #DDD6C7 !important; text-align: center;
                        }
                        .akshab-report .ak-table td.ak-right { text-align: right; }
                        .akshab-report .ak-table tr:nth-child(even) td { background-color: #F7F4EE; }
                        .ak-table tr { page-break-inside: avoid; }
                        .ak-table thead { display: table-header-group; page-break-inside: avoid; }
                        .akshab-report .ak-total-row td {
                            background-color: #EAE0CC !important; color: #1B4332;
                            font-weight: bold; font-size: 14.5px;
                            border-top: 2px solid #C6A46C !important;
                        }
                        .akshab-report .ak-subtotal-row td {
                            background-color: #F0E9DA !important; color: #1B4332;
                            font-weight: bold; font-size: 14px;
                        }
                        .akshab-report .ak-cat-row td {
                            background-color: #2D5443 !important; color: #FFFFFF;
                            font-weight: bold; text-align: right; font-size: 14.5px;
                        }
                        .akshab-report .ak-cat-row td.ak-num { text-align: center; }
                        .ak-pos-band {
                            background-color: #C6A46C; color: #1B4332;
                            font-weight: bold; font-size: 16px;
                            padding: 8px 15px; margin: 18px 0 0 0;
                            page-break-after: avoid;
                        }
                        .ak-empty { color: #8A8A8A; font-size: 14px; padding: 12px 6px; font-style: italic; }
                        .ak-amount { direction: ltr; unicode-bidi: embed; white-space: nowrap; }
                        .ak-badge-new { color: #1B4332; font-weight: bold; }
                        .ak-badge-old { color: #7A6A45; font-weight: bold; }
                        /* ---------- إضافات التقرير الأسبوعي ---------- */
                        .akshab-report .ak-best-row td {
                            background-color: #F3E9D2 !important;
                            border-top: 1px solid #C6A46C !important;
                            border-bottom: 1px solid #C6A46C !important;
                            font-weight: bold; color: #1B4332;
                        }
                        .ak-best-badge { color: #C6A46C; font-weight: bold; float: left; direction: rtl; }
                        .ak-up { color: #1B4332; font-weight: bold; }
                        .ak-down { color: #A94438; font-weight: bold; }
                        .ak-flat { color: #7A6A45; font-weight: bold; }
                        .akshab-report .ak-matrix th { font-size: 13px; padding: 8px 3px; }
                        .akshab-report .ak-matrix td { font-size: 13.5px; padding: 8px 3px; }
                        .ak-rank { color: #C6A46C; font-weight: bold; }
                    </style>
                        <style>
                        .ak-channel-band { background-color: #1B4332; color: #FFFFFF; padding: 14px 20px; margin-bottom: 4px; }
                        .ak-channel-name { font-size: 25px; font-weight: bold; }
                        .ak-channel-sub { font-size: 13px; color: #C6A46C; margin-top: 2px; }
                        </style>
                        <div class="ak-channel-band">
                            <div class="ak-channel-name">تفاصيل المبيعات - <t t-out="channel['name']"/></div>
                            <div class="ak-channel-sub"><t t-out="data['month_label']"/> | <t t-out="data['month_from']"/> - <t t-out="data['month_to']"/></div>
                        </div>
                        <table class="ak-kpi-table">
                            <tr>
                                <td class="ak-kpi"><div class="ak-kpi-value"><span class="ak-amount" t-out="channel['kpis']['net_fmt']"/></div><div class="ak-kpi-label">صافي المبيعات (<t t-out="data['currency']"/>)</div></td>
                                <td class="ak-kpi"><div class="ak-kpi-value"><span class="ak-amount" t-out="channel['kpis']['refunds_fmt']"/></div><div class="ak-kpi-label">المرتجعات (<t t-out="data['currency']"/>)</div></td>
                                <td class="ak-kpi"><div class="ak-kpi-value" t-out="channel['kpis']['invoices']"/><div class="ak-kpi-label">عدد الفواتير</div></td>
                                <td class="ak-kpi"><div class="ak-kpi-value"><span class="ak-amount" t-out="channel['kpis']['avg_fmt']"/></div><div class="ak-kpi-label">متوسط الفاتورة (<t t-out="data['currency']"/>)</div></td>
                                <td class="ak-kpi"><div class="ak-kpi-value"><span class="ak-amount" t-out="channel['kpis']['discounts_fmt']"/></div><div class="ak-kpi-label">إجمالي الخصومات (<t t-out="data['currency']"/>)</div></td>
                                <td class="ak-kpi"><div class="ak-kpi-value" t-out="channel['kpis']['customers']"/><div class="ak-kpi-label">عدد العملاء</div></td>
                            </tr>
                        </table>

                        <!-- ١ أداء أسابيع الشهر -->
                        <t t-if="not channel['weeks']['rows']">
                            <div class="ak-keep">
                                <div class="ak-section-title"><span class="ak-section-num">١</span> أداء أسابيع الشهر</div>
                                <p class="ak-empty">لا توجد مبيعات ضمن الشهر المحدد.</p>
                            </div>
                        </t>
                        <div t-if="channel['weeks']['rows']" class="ak-keep ak-section-block">
                        <table class="ak-table">
                            <caption class="ak-section-caption"><span class="ak-section-num">١</span> أداء أسابيع الشهر</caption>
                            <thead>
                                <tr>
                                    <th style="width: 26%;">الأسبوع</th>
                                    <th style="width: 16%;">صافي المبيعات (<t t-out="data['currency']"/>)</th>
                                    <th style="width: 12%;">عدد الفواتير</th>
                                    <th style="width: 15%;">متوسط الفاتورة</th>
                                    <th style="width: 16%;">الخصومات (<t t-out="data['currency']"/>)</th>
                                    <th style="width: 15%;">عدد العملاء</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="channel['weeks']['rows']" t-as="row" t-att-class="'ak-best-row' if row['is_best'] else None">
                                    <td class="ak-right">
                                        <span t-if="row['is_best']" class="ak-best-badge">◆ الأفضل</span>
                                        <t t-out="row['label']"/> <span class="ak-amount" t-out="row['range_fmt']"/>
                                    </td>
                                    <td><span class="ak-amount" t-out="row['total_fmt']"/></td>
                                    <td t-out="row['count']"/>
                                    <td><span class="ak-amount" t-out="row['avg_fmt']"/></td>
                                    <td><span class="ak-amount" t-out="row['discounts_fmt']"/></td>
                                    <td t-out="row['customers']"/>
                                </tr>
                                <tr class="ak-total-row">
                                    <td class="ak-right">إجمالي الشهر</td>
                                    <td><span class="ak-amount" t-out="channel['weeks']['total']['total_fmt']"/></td>
                                    <td t-out="channel['weeks']['total']['count']"/>
                                    <td><span class="ak-amount" t-out="channel['weeks']['total']['avg_fmt']"/></td>
                                    <td><span class="ak-amount" t-out="channel['weeks']['total']['discounts_fmt']"/></td>
                                    <td t-out="channel['weeks']['total']['customers']"/>
                                </tr>
                            </tbody>
                        </table>
                        </div>

                        <!-- ٢ فواتير المبيعات - كاملة تنازلياً -->
                        <t t-if="not channel['invoices']['rows']">
                            <div class="ak-keep">
                                <div class="ak-section-title"><span class="ak-section-num">٢</span> فواتير المبيعات (من الأعلى إلى الأقل)</div>
                                <p class="ak-empty">لا توجد فواتير مبيعات ضمن الشهر المحدد.</p>
                            </div>
                        </t>
                        <div t-if="channel['invoices']['rows']" t-att-class="('ak-keep' if channel['invoices']['count'] &lt;= 10 else 'ak-page-start') + ' ak-section-block'">
                        <table class="ak-table">
                            <caption class="ak-section-caption"><span class="ak-section-num">٢</span> فواتير المبيعات (من الأعلى إلى الأقل)</caption>
                            <thead>
                                <tr>
                                    <th style="width: 12%;">التاريخ</th>
                                    <th style="width: 14%;">رقم الفاتورة</th>
                                    <th style="width: 17%;">العميل</th>
                                    <th style="width: 13%;">رقم الهاتف</th>
                                    <th style="width: 8%;">عميل جديد؟</th>
                                    <th style="width: 12%;">تاريخ آخر فاتورة</th>
                                    <th style="width: 10%;">الأيام منذ آخر فاتورة</th>
                                    <th style="width: 14%;">الإجمالي (<t t-out="data['currency']"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="channel['invoices']['rows']" t-as="row">
                                    <td><span class="ak-amount" t-out="row['date']"/></td>
                                    <td><span class="ak-amount" t-out="row['number']"/></td>
                                    <td t-out="row['customer']"/>
                                    <td><span class="ak-amount" t-out="row['phone']"/></td>
                                    <td t-out="row['is_new']"/>
                                    <td><span class="ak-amount" t-out="row['last_inv']"/></td>
                                    <td t-out="row['days']"/>
                                    <td><span class="ak-amount" t-out="row['total_fmt']"/></td>
                                </tr>
                                <tr class="ak-total-row">
                                    <td class="ak-right" colspan="2">الإجمالي</td>
                                    <td colspan="5">عدد الفواتير: <t t-out="channel['invoices']['count']"/></td>
                                    <td><span class="ak-amount" t-out="channel['invoices']['total_fmt']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        </div>

                        <!-- ٣ المرتجعات - كاملة تنازلياً -->
                        <t t-if="not channel['refunds']['rows']">
                            <div class="ak-keep">
                                <div class="ak-section-title"><span class="ak-section-num">٣</span> فواتير مرتجعات المبيعات</div>
                                <p class="ak-empty">لا توجد مرتجعات مبيعات ضمن الشهر المحدد.</p>
                            </div>
                        </t>
                        <div t-if="channel['refunds']['rows']" t-att-class="('ak-keep' if channel['refunds']['count'] &lt;= 10 else 'ak-page-start') + ' ak-section-block'">
                        <table class="ak-table">
                            <caption class="ak-section-caption"><span class="ak-section-num">٣</span> فواتير مرتجعات المبيعات (من الأعلى إلى الأقل)</caption>
                            <thead>
                                <tr>
                                    <th style="width: 14%;">التاريخ</th>
                                    <th style="width: 17%;">رقم الفاتورة</th>
                                    <th style="width: 21%;">العميل</th>
                                    <th style="width: 16%;">رقم الهاتف</th>
                                    <th style="width: 14%;">تاريخ آخر فاتورة</th>
                                    <th style="width: 18%;">الإجمالي (<t t-out="data['currency']"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="channel['refunds']['rows']" t-as="row">
                                    <td><span class="ak-amount" t-out="row['date']"/></td>
                                    <td><span class="ak-amount" t-out="row['number']"/></td>
                                    <td t-out="row['customer']"/>
                                    <td><span class="ak-amount" t-out="row['phone']"/></td>
                                    <td><span class="ak-amount" t-out="row['last_inv']"/></td>
                                    <td><span class="ak-amount" t-out="row['total_fmt']"/></td>
                                </tr>
                                <tr class="ak-total-row">
                                    <td class="ak-right" colspan="2">الإجمالي</td>
                                    <td colspan="3">عدد المرتجعات: <t t-out="channel['refunds']['count']"/></td>
                                    <td><span class="ak-amount" t-out="channel['refunds']['total_fmt']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        </div>

                        <!-- ٤ المنتجات حسب الفئة - كاملة تنازلياً -->
                        <div class="ak-page-start ak-section-block">
                        <div class="ak-section-title"><span class="ak-section-num">٤</span> مبيعات المنتجات حسب الفئة (كل المنتجات من الأعلى إلى الأقل)</div>
                        <t t-if="not channel['products']['categories']">
                            <p class="ak-empty">لا توجد مبيعات منتجات ضمن الشهر المحدد.</p>
                        </t>
                        <t t-foreach="channel['products']['categories']" t-as="cat">
                            <div t-att-class="'ak-keep' if cat['product_count'] &lt;= 15 else None">
                            <table class="ak-table ak-cat-table">
                                <thead>
                                    <tr class="ak-cat-row">
                                        <th class="ak-right" style="width: 40%;" t-out="cat['name']"/>
                                        <th style="width: 12%;" t-out="cat['qty_fmt']"/>
                                        <th style="width: 16%;"><span class="ak-amount" t-out="cat['avg_fmt']"/></th>
                                        <th style="width: 14%;"><span class="ak-amount" t-out="cat['discount_fmt']"/></th>
                                        <th style="width: 18%;"><span class="ak-amount" t-out="cat['total_fmt']"/></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="cat['products']" t-as="prod">
                                        <td class="ak-right" t-out="prod['name']"/>
                                        <td t-out="prod['qty_fmt']"/>
                                        <td><span class="ak-amount" t-out="prod['avg_fmt']"/></td>
                                        <td><span class="ak-amount" t-out="prod['discount_fmt']"/></td>
                                        <td><span class="ak-amount" t-out="prod['total_fmt']"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            </div>
                        </t>
                        <table t-if="channel['products']['categories']" class="ak-table">
                            <tbody>
                                <tr class="ak-total-row">
                                    <td class="ak-right" style="width: 40%;">الإجمالي</td>
                                    <td style="width: 12%;" t-out="channel['products']['total_qty_fmt']"/>
                                    <td style="width: 16%;"><span class="ak-amount" t-out="channel['products']['total_avg_fmt']"/></td>
                                    <td style="width: 14%;"><span class="ak-amount" t-out="channel['products']['total_discount_fmt']"/></td>
                                    <td style="width: 18%;"><span class="ak-amount" t-out="channel['products']['total_fmt']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        </div>

                        <!-- ٥ ملخص الفئات -->
                        <t t-if="not channel['category_summary']['rows']">
                            <div class="ak-keep">
                                <div class="ak-section-title"><span class="ak-section-num">٥</span> المبيعات حسب الفئة</div>
                                <p class="ak-empty">لا توجد مبيعات فئات ضمن الشهر المحدد.</p>
                            </div>
                        </t>
                        <div t-if="channel['category_summary']['rows']" t-att-class="('ak-keep' if channel['category_summary']['count'] &lt;= 12 else 'ak-page-start') + ' ak-section-block'">
                        <table class="ak-table">
                            <caption class="ak-section-caption"><span class="ak-section-num">٥</span> المبيعات حسب الفئة</caption>
                            <thead>
                                <tr>
                                    <th style="width: 28%;">الفئة</th>
                                    <th style="width: 13%;">الكمية المباعة</th>
                                    <th style="width: 15%;">متوسط سعر الوحدة</th>
                                    <th style="width: 15%;">إجمالي الخصم (<t t-out="data['currency']"/>)</th>
                                    <th style="width: 16%;">الإجمالي (<t t-out="data['currency']"/>)</th>
                                    <th style="width: 13%;">النسبة من المبيعات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="channel['category_summary']['rows']" t-as="row">
                                    <td class="ak-right" t-out="row['name']"/>
                                    <td t-out="row['qty_fmt']"/>
                                    <td><span class="ak-amount" t-out="row['avg_fmt']"/></td>
                                    <td><span class="ak-amount" t-out="row['discount_fmt']"/></td>
                                    <td><span class="ak-amount" t-out="row['total_fmt']"/></td>
                                    <td><span class="ak-amount" t-out="row['share_fmt']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        </div>

                        <!-- ٦ العملاء - الكل تنازلياً -->
                        <t t-if="not channel['customers']['rows']">
                            <div class="ak-keep">
                                <div class="ak-section-title"><span class="ak-section-num">٦</span> العملاء - الأعلى إنفاقاً</div>
                                <p class="ak-empty">لا يوجد عملاء مسجلون ضمن الشهر المحدد.</p>
                            </div>
                        </t>
                        <div t-if="channel['customers']['rows']" t-att-class="('ak-keep' if channel['customers']['total_customers'] &lt;= 10 else 'ak-page-start') + ' ak-section-block'">
                        <table class="ak-table">
                            <caption class="ak-section-caption"><span class="ak-section-num">٦</span> جميع العملاء (من الأعلى إنفاقاً إلى الأقل)</caption>
                            <thead>
                                <tr>
                                    <th style="width: 6%;">#</th>
                                    <th style="width: 26%;">العميل</th>
                                    <th style="width: 17%;">رقم الهاتف</th>
                                    <th style="width: 11%;">نوع العميل</th>
                                    <th style="width: 11%;">عدد الفواتير</th>
                                    <th style="width: 14%;">متوسط الفاتورة (<t t-out="data['currency']"/>)</th>
                                    <th style="width: 15%;">إجمالي المشتريات (<t t-out="data['currency']"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="channel['customers']['rows']" t-as="row">
                                    <td><span class="ak-rank" t-out="row['rank']"/></td>
                                    <td class="ak-right" t-out="row['name']"/>
                                    <td><span class="ak-amount" t-out="row['phone']"/></td>
                                    <td t-out="row['ptype']"/>
                                    <td t-out="row['count']"/>
                                    <td><span class="ak-amount" t-out="row['avg_fmt']"/></td>
                                    <td><span class="ak-amount" t-out="row['total_fmt']"/></td>
                                </tr>
                                <tr class="ak-total-row">
                                    <td class="ak-right" colspan="7">إجمالي عملاء الشهر المسجلين: <t t-out="channel['customers']['total_customers']"/> عميلاً</td>
                                </tr>
                            </tbody>
                        </table>
                        </div>

                        <!-- ٧ الموظفون -->
                        <t t-if="not channel['employees']['rows']">
                            <div class="ak-keep">
                                <div class="ak-section-title"><span class="ak-section-num">٧</span> مبيعات الموظفين</div>
                                <p class="ak-empty">لا توجد مبيعات موظفين ضمن الشهر المحدد.</p>
                            </div>
                        </t>
                        <div t-if="channel['employees']['rows']" class="ak-keep ak-section-block">
                        <table class="ak-table">
                            <caption class="ak-section-caption"><span class="ak-section-num">٧</span> مبيعات الموظفين</caption>
                            <thead>
                                <tr>
                                    <th style="width: 24%;">الموظف</th>
                                    <th style="width: 15%;">صافي المبيعات (<t t-out="data['currency']"/>)</th>
                                    <th style="width: 10%;">عدد الفواتير</th>
                                    <th style="width: 13%;">متوسط الفاتورة</th>
                                    <th style="width: 14%;">الخصومات (<t t-out="data['currency']"/>)</th>
                                    <th style="width: 8%;">عدد العملاء</th>
                                    <th style="width: 8%;">عملاء جدد</th>
                                    <th style="width: 8%;">عملاء قدامى</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="channel['employees']['rows']" t-as="row">
                                    <td class="ak-right" t-out="row['name']"/>
                                    <td><span class="ak-amount" t-out="row['total_fmt']"/></td>
                                    <td t-out="row['count']"/>
                                    <td><span class="ak-amount" t-out="row['avg_fmt']"/></td>
                                    <td><span class="ak-amount" t-out="row['discounts_fmt']"/></td>
                                    <td t-out="row['customers']"/>
                                    <td t-out="row['new']"/>
                                    <td t-out="row['old']"/>
                                </tr>
                                <tr class="ak-total-row">
                                    <td class="ak-right">الإجمالي</td>
                                    <td><span class="ak-amount" t-out="channel['employees']['subtotal']['total_fmt']"/></td>
                                    <td t-out="channel['employees']['subtotal']['count']"/>
                                    <td><span class="ak-amount" t-out="channel['employees']['subtotal']['avg_fmt']"/></td>
                                    <td><span class="ak-amount" t-out="channel['employees']['subtotal']['discounts_fmt']"/></td>
                                    <td t-out="channel['employees']['subtotal']['customers']"/>
                                    <td t-out="channel['employees']['subtotal']['new']"/>
                                    <td t-out="channel['employees']['subtotal']['old']"/>
                                </tr>
                            </tbody>
                        </table>
                        </div>

                        <!-- ٨ الخصومات -->
                        <t t-if="not channel['discounts']">
                            <div class="ak-keep">
                                <div class="ak-section-title"><span class="ak-section-num">٨</span> تحليل الخصومات</div>
                                <p class="ak-empty">لا توجد خصومات ضمن الشهر المحدد.</p>
                            </div>
                        </t>
                        <div t-if="channel['discounts']" class="ak-keep ak-section-block">
                        <table class="ak-table">
                            <caption class="ak-section-caption"><span class="ak-section-num">٨</span> تحليل الخصومات</caption>
                            <thead>
                                <tr>
                                    <th style="width: 40%;">الخصم</th>
                                    <th style="width: 20%;">إجمالي الخصم (<t t-out="data['currency']"/>)</th>
                                    <th style="width: 20%;">عدد الفواتير</th>
                                    <th style="width: 20%;">متوسط خصم الفاتورة (<t t-out="data['currency']"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="channel['discounts']['rows']" t-as="row">
                                    <td class="ak-right" t-out="row['name']"/>
                                    <td><span class="ak-amount" t-out="row['total_fmt']"/></td>
                                    <td t-out="row['count']"/>
                                    <td><span class="ak-amount" t-out="row['avg_fmt']"/></td>
                                </tr>
                                <tr class="ak-total-row">
                                    <td class="ak-right">الإجمالي</td>
                                    <td><span class="ak-amount" t-out="channel['discounts']['subtotal_fmt']"/></td>
                                    <td t-out="channel['discounts']['subtotal_count']"/>
                                    <td><span class="ak-amount" t-out="channel['discounts']['subtotal_avg_fmt']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
